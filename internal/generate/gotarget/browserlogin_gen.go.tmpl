		if st, err := os.Stat(p); err == nil && !st.IsDir() {
			return p
		}
	}
	for _, n := range names {
		if p, err := exec.LookPath(n); err == nil && p != "" {
			if abs, err := filepath.Abs(p); err == nil {
				p = abs

		home, err := os.UserHomeDir()
		if err != nil {
			return "", "", fmt.Errorf("finding the home folder for the files folder: %w (set %s_FILES_DIR)", err, envPrefix)
		}
		if dir == "" {
			dir = filepath.Join(home, "har2mcp-files", serviceName)
		} else {
			dir = filepath.Join(home, dir[1:])
		}
	}
	if abs, err = filepath.Abs(dir); err != nil {
		return "", "", err
	}
	if err := os.MkdirAll(abs, 0o700); err != nil {
		return "", "", fmt.Errorf("creating the files folder: %w", err)
	}
	if real, err = filepath.EvalSymlinks(abs); err != nil {
		return "", "", err
	}

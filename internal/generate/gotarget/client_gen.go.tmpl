	for _, vs := range r.query {
		for i := range vs {
			vs[i] = rep.Replace(vs[i])
		}
	}
	if len(r.headers) > 0 {
		h := make(map[string]string, len(r.headers))
		for k, v := range r.headers {
			h[k] = rep.Replace(v)
		}
		r.headers = h
	}
	return r
}

func replaceStrings(v any, rep *strings.Replacer) any {
	switch x := v.(type) {
	case string:
		return rep.Replace(x)
	case map[string]any:
		for k, e := range x {
			x[k] = replaceStrings(e, rep)
		}
		return x
	case []any:
		for i, e := range x {
			x[i] = replaceStrings(e, rep)
		}
		return x
	}
	return v
}

func tokenFromCookie() bool {
	for _, tf := range tokenFlows {
		if tf.From.Cookie != "" {
			return true
		}
	}
	return false
}

func (c *Client) missingSessionCookies() []string {
	have := map[string]bool{}
	urls := []*url.URL{c.base.JoinPath("/")}
	if loginRequest != nil {
		urls = append(urls, c.base.JoinPath(loginRequest.Path))
	}
	for _, u := range urls {
		for _, ck := range c.jar.Cookies(u) {
			if ck.Value != "" {
				have[ck.Name] = true
			}
		}
	}
	var missing []string
	for _, name := range sessionCookies {
		if !have[name] {
			missing = append(missing, name)
		}
	}
	return missing
}

// captureTokens reads the session tokens from the login response.
func (c *Client) captureTokens(header http.Header, body []byte, final *url.URL) {
	c.tokMu.Lock()
	defer c.tokMu.Unlock()
	for i, tf := range tokenFlows {
		var v, where string
		switch f := tf.From; {
		case f.ResponseJSON != "":
			v, where = jsonPath(body, f.ResponseJSON), "response field "+f.ResponseJSON
		case f.Body != "":
			v, where = jsonPath(body, f.Body), "response field "+f.Body
		case f.ResponseHeader != "":
			v, where = header.Get(f.ResponseHeader), "response header "+f.ResponseHeader
		case f.Header != "":
			v, where = header.Get(f.Header), "response header "+f.Header
		case f.Query != "":
			where = "query parameter " + f.Query
			if final != nil {
				v = final.Query().Get(f.Query)
			}
			if loc, err := url.Parse(header.Get("Location")); v == "" && err == nil {
				v = loc.Query().Get(f.Query)
			}
		default:
			continue // cookies are read when each request is sent
		}
		if v == "" {
			log.Printf("warning: the login response has no %s for token %q; requests may fail (see auth.session.tokens in the spec)", where, tf.Name)
			continue
		}
		c.tokens[i] = v
	}
}

// captureHeaderTokens refreshes tokens that come from a response header,
// for devices that rotate them.
func (c *Client) captureHeaderTokens(header http.Header) {
	c.tokMu.Lock()
	defer c.tokMu.Unlock()
	for i, tf := range tokenFlows {
		name := tf.From.ResponseHeader
		if name == "" {
			name = tf.From.Header
		}
		if name != "" {
			if v := header.Get(name); v != "" {
				c.tokens[i] = v
			}
		}
	}
}

// tokenValue is the current value of tokenFlows[i].
func (c *Client) tokenValue(i int) string {
	if name := tokenFlows[i].From.Cookie; name != "" {
		for _, ck := range c.jar.Cookies(c.base.JoinPath("/")) {
			if ck.Name == name {
				return ck.Value
			}
		}
		return ""
	}
	c.tokMu.Lock()
	defer c.tokMu.Unlock()
	return c.tokens[i]
}

// sessionExpired reports whether resp says the session has expired. It may
// read the start of the body; the body still reads in full afterwards.
func sessionExpired(resp *http.Response) bool {
	for _, code := range reloginOn {
		if resp.StatusCode == code {
			return true
		}
	}
	if reloginBodyContains == "" || isAttachment(resp.Header) {
		return false
	}
	peek := make([]byte, 64<<10)
	n, _ := io.ReadFull(resp.Body, peek)
	peek = peek[:n]
	resp.Body = readCloser{io.MultiReader(bytes.NewReader(peek), resp.Body), resp.Body}
	return bytes.Contains(peek, []byte(reloginBodyContains))
}

func isAttachment(h http.Header) bool {
	d, _, err := mime.ParseMediaType(h.Get("Content-Disposition"))
	return err == nil && d == "attachment"
}

type readCloser struct {
	io.Reader
	io.Closer
}

func (c *Client) roundTrip(ctx context.Context, r *request) (*http.Response, error) {
	req, err := c.newHTTPRequest(ctx, r)
	if err != nil {
		return nil, err
	}
	resp, err := c.http.Do(req)
	if err != nil {
		return nil, err
	}
	c.captureHeaderTokens(resp.Header)
	return resp, nil
}

// newHTTPRequest builds the HTTP request for r, with the session tokens.
func (c *Client) newHTTPRequest(ctx context.Context, r *request) (*http.Request, error) {
	query := url.Values{}
	for k, v := range r.query {
		query[k] = append([]string(nil), v...)
	}
	body := copyMap(r.body)
	tokenHeaders := map[string]string{}
	var tokenCookies []*http.Cookie
	for i, tf := range tokenFlows {
		v := c.tokenValue(i)
		if v == "" {
			continue
		}
		switch {
		case tf.To.Header != "":
			tokenHeaders[tf.To.Header] = v
		case tf.To.Query != "":
			query.Set(tf.To.Query, v)
		case tf.To.Body != "":
			if body == nil {
				body = map[string]any{}
			}
			setField(body, r.bodyType, tf.To.Body, v)
		case tf.To.Cookie != "":
			tokenCookies = append(tokenCookies, &http.Cookie{Name: tf.To.Cookie, Value: v})
		}
	}

	target := c.origin() + r.path
	if len(query) > 0 {
		target += "?" + query.Encode()
	}
	var (
		rdr      io.Reader
		closer   io.Closer
		ctype    string
		length   int64 = -1
		bodyType       = r.bodyType
	)
	if bodyType == "" || bodyType == "none" {
		if len(body) == 0 {
			bodyType = "none"
		} else {
			bodyType = "json"
		}
	}
	switch bodyType {
	case "json":
		b, err := marshalJSON(body)
		if err != nil {
			return nil, err
		}
		rdr, ctype = bytes.NewReader(b), "application/json"
	case "form":
		rdr, ctype = strings.NewReader(formValues(body).Encode()), "application/x-www-form-urlencoded"
	case "multipart":
		var err error
		rdr, ctype, length, closer, err = multipartBody(body, r.upload)
		if err != nil {
			return nil, err
		}
	}
	req, err := http.NewRequestWithContext(ctx, r.method, target, rdr)
	if err != nil {
		if closer != nil {
			closer.Close()
		}
		return nil, err
	}
	if closer != nil {
		req.Body = readCloser{rdr, closer}
		req.ContentLength = length
	}
	req.Header.Set("Accept", "application/json, text/plain, */*")
	req.Header.Set("User-Agent", serverName+"/"+serverVersion+" (generated by har2mcp)")
	req.Header.Set("Referer", c.origin()+"/")
	if r.method != http.MethodGet && r.method != http.MethodHead {
		req.Header.Set("Origin", c.origin())
	}
	if ctype != "" {
		req.Header.Set("Content-Type", ctype)
	}
	for k, v := range r.headers {
		req.Header.Set(k, v)
	}
	for k, v := range tokenHeaders {
		req.Header.Set(k, v)
	}
	for _, ck := range tokenCookies {
		req.AddCookie(ck)
	}
	return req, nil
}

func marshalJSON(v any) ([]byte, error) {
	if v == nil {
		v = map[string]any{}
	}
	var buf bytes.Buffer
	enc := json.NewEncoder(&buf)
	enc.SetEscapeHTML(false)
	if err := enc.Encode(v); err != nil {
		return nil, err
	}
	return bytes.TrimRight(buf.Bytes(), "\n"), nil
}

// multipartBody streams body's fields and the upload part. The length is
// known up front, so devices that need a Content-Length get one, and the
// file is never held in memory.
func multipartBody(body map[string]any, up *uploadPart) (io.Reader, string, int64, io.Closer, error) {
	var buf bytes.Buffer
	mw := multipart.NewWriter(&buf)
	for _, k := range sortedKeys(body) {
		for _, v := range formStrings(body[k]) {
			if err := mw.WriteField(k, v); err != nil {
				return nil, "", 0, nil, err
			}
		}
	}
	if up == nil {
		if err := mw.Close(); err != nil {
			return nil, "", 0, nil, err
		}
		return bytes.NewReader(buf.Bytes()), mw.FormDataContentType(), int64(buf.Len()), nil, nil
	}
	h := make(textproto.MIMEHeader)
	h.Set("Content-Disposition", fmt.Sprintf(`form-data; name="%s"; filename="%s"`, quoteEscaper.Replace(up.field), quoteEscaper.Replace(up.name)))
	h.Set("Content-Type", up.contentType)
	if _, err := mw.CreatePart(h); err != nil {
		return nil, "", 0, nil, err
	}
	split := buf.Len()
	if err := mw.Close(); err != nil {
		return nil, "", 0, nil, err
	}
	all := buf.Bytes()
	head, tail := all[:split], all[split:]
	f, err := os.Open(up.path)
	if err != nil {
		return nil, "", 0, nil, err
	}
	rdr := io.MultiReader(bytes.NewReader(head), io.NewSectionReader(f, up.offset, up.length), bytes.NewReader(tail))
	return rdr, mw.FormDataContentType(), int64(len(head)) + up.length + int64(len(tail)), f, nil
}

var quoteEscaper = strings.NewReplacer("\\", "\\\\", `"`, "\\\"")

func formValues(body map[string]any) url.Values {
	v := url.Values{}
	for _, k := range sortedKeys(body) {
		v[k] = formStrings(body[k])
	}
	return v
}

// formStrings turns a value into form or query values: arrays repeat the
// key, objects are sent as JSON.
func formStrings(v any) []string {
	if list, ok := v.([]any); ok {
		out := make([]string, len(list))
		for i, e := range list {
			out[i] = scalarString(e)
		}
		return out
	}
	return []string{scalarString(v)}
}

func addQuery(q url.Values, key string, v any) {
	for _, s := range formStrings(v) {
		q.Add(key, s)
	}
}

// scalarString formats a value for a URL, form field or header.
func scalarString(v any) string {
	switch x := v.(type) {
	case nil:
		return ""
	case string:
		return x
	case json.Number:
		return x.String()
	case bool:
		return strconv.FormatBool(x)
	case int:
		return strconv.Itoa(x)
	case int64:
		return strconv.FormatInt(x, 10)
	case float64:
		return strconv.FormatFloat(x, 'f', -1, 64)
	default:
		b, _ := json.Marshal(x)
		return string(b)
	}
}

// setField sets a body field: a dotted path in JSON bodies, a plain key in
// form and multipart bodies.
func setField(body map[string]any, bodyType, field string, v any) {
	if bodyType == "form" || bodyType == "multipart" {
		body[field] = v
		return
	}
	parts := strings.Split(field, ".")
	cur := body
	for _, p := range parts[:len(parts)-1] {
		next, ok := cur[p].(map[string]any)
		if !ok {
			next = map[string]any{}
			cur[p] = next
		}
		cur = next
	}
	cur[parts[len(parts)-1]] = v
}

// jsonPath returns the value at a dotted path ("data.token", "items.0.id")
// in a JSON document as a string, or "" when there is none.
func jsonPath(doc []byte, path string) string {
	dec := json.NewDecoder(bytes.NewReader(doc))
	dec.UseNumber()
	var v any
	if err := dec.Decode(&v); err != nil {
		return ""
	}
	for _, p := range strings.Split(path, ".") {
		switch x := v.(type) {
		case map[string]any:
			v = x[p]
		case []any:
			i, err := strconv.Atoi(p)
			if err != nil || i < 0 || i >= len(x) {
				return ""
			}
			v = x[i]
		default:
			return ""
		}
	}
	switch v.(type) {
	case string, json.Number, bool:
		return scalarString(v)
	}
	return ""
}

// copyMap deep-copies a JSON-like map, so fixed values are never changed.
func copyMap(m map[string]any) map[string]any {
	if m == nil {
		return nil
	}
	out, _ := copyValue(m).(map[string]any)
	return out
}

func copyValue(v any) any {
	switch x := v.(type) {
	case map[string]any:
		m := make(map[string]any, len(x))
		for k, e := range x {
			m[k] = copyValue(e)
		}
		return m
	case []any:
		s := make([]any, len(x))
		for i, e := range x {
			s[i] = copyValue(e)
		}
		return s
	}
	return v
}

func sortedKeys[V any](m map[string]V) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

// snippet returns the start of b as text for an error message.
func snippet(b []byte, n int) string {
	s := strings.TrimSpace(string(b))
	if len(s) > n {
		s = s[:n] + "..."
	}
	if s == "" {
		s = "(empty body)"
	}
	return s
}

// num holds a number from the spec that Go cannot store exactly. It is sent
// as written.
func num(s string) json.Number { return json.Number(s) }

func ptr[T any](v T) *T { return &v }

// sessionJar is a cookie jar that a new login can empty.
type sessionJar struct {
	mu  sync.Mutex
	jar *cookiejar.Jar
}

func newSessionJar() *sessionJar {
	j := &sessionJar{}
	j.reset()
	return j
}

func (j *sessionJar) reset() {
	jar, _ := cookiejar.New(nil)
	j.mu.Lock()
	j.jar = jar
	j.mu.Unlock()
}

func (j *sessionJar) current() *cookiejar.Jar {
	j.mu.Lock()
	defer j.mu.Unlock()
	return j.jar
}

func (j *sessionJar) SetCookies(u *url.URL, cookies []*http.Cookie) {
	j.current().SetCookies(u, cookies)
}

func (j *sessionJar) Cookies(u *url.URL) []*http.Cookie { return j.current().Cookies(u) }

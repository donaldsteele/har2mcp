			if resp, err := c.http.Do(req); err == nil {
				io.Copy(io.Discard, io.LimitReader(resp.Body, 4<<20))
				resp.Body.Close()
			}
		}
	}
	r := c.withCredentials(loginRequest)
	req, err := c.newHTTPRequest(ctx, r)
	if err != nil {
		return err
	}
	resp, err := c.http.Do(req)
	if err != nil {
		return err
	}
	defer resp.Body.Close()
	body, _ := io.ReadAll(io.LimitReader(resp.Body, 4<<20))
	if resp.StatusCode >= 400 {
		return fmt.Errorf("HTTP %s from %s %s: %s; check %s_USER and %s_PASSWORD", resp.Status, r.method, r.path, snippet(body, 300), envPrefix, envPrefix)
	}
	if missing := c.missingSessionCookies(); len(missing) > 0 {
		return fmt.Errorf("the device did not set the session cookie %s (HTTP %s: %s); check %s_USER and %s_PASSWORD, or auth.session.cookies in the spec",
			strings.Join(missing, ", "), resp.Status, snippet(body, 300), envPrefix, envPrefix)
	}
	c.captureTokens(resp.Header, body, resp.Request.URL)
	return nil
}

// withCredentials returns the login request with the username and password
// filled in.
func (c *Client) withCredentials(op *operation) *request {
	rep := strings.NewReplacer(userPlaceholder, c.user, passwordPlaceholder, c.password)
	r := newRequest(op)
